# ============================================================================
# 智享AI底座 — Docker 构建上下文忽略清单
#
# 作用：减小构建上下文体积，且避免敏感文件（.env）进入镜像层。
# ============================================================================

# 依赖与构建产物（镜像内重建）
node_modules
dist
coverage
*.tsbuildinfo

# 环境变量与密钥（禁止进入镜像）
.env
.env.*

# 版本控制
.git
.gitignore

# 日志与临时文件
*.log
logs
knowledge/*.tmp
knowledge/*_cache/

# 测试与文档（运行阶段不需要）
test
docs

# IDE 与系统文件
.idea
.vscode
*.swp
*.swo
.DS_Store
Thumbs.db
